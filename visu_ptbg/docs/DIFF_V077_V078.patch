+
+    # ----------------------------------------------------------
+    # 5) CONSUMER VOTES
+    # ----------------------------------------------------------
+
+    axs[4].step(df["t_ms"], df["cons1_vote"],where="post", linewidth=2, label="Cons1")
+    axs[4].step(df["t_ms"], df["cons2_vote"],where="post", linewidth=2, label="Cons2")
