+
+SQW_F           = 1
+SQW_MN          = 0
+SQW_MX          = 1
+SQW_CR          = 50
+SOURCE_CYCLE    = 0.001
+
+DT              = 0.001
+T_SIM           = 10
+HB_TIMEOUT      = 0.050
+STALL_LIMIT     = 2
+TIME_FAULT      = 8
