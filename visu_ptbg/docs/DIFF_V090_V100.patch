+        f.write(f">Cycle rate calculated: {cycle_rate:.2f} %\n\n")
+
+        for pid in [1, 2, 3]:
+            p = producers[pid]
+            f.write(f"## Producer {pid}\n")
+            f.write(f">start time: {p['start']:.3f} ms\n")
+            f.write(f">mean delay edges / source: {p['delay']:.3f} ms\n")
+            f.write(f">overruns: {p['overruns']}\n\n")
