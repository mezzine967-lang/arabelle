+    PUB_EDGES = rising_edges_bool(DF["pub_output"], T)
+    # liste de TOUS les instants de publication (plus robuste)
+    PUB_TIMES = DF.loc[DF["pub_output"].notna(), "t_ms"].to_numpy(dtype=float)
